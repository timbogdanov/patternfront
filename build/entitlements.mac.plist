<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Inert until signing is turned on (hardenedRuntime: false in
    electron-builder.yml). Kept here so enabling a Developer ID is a matter of
    setting CSC_LINK / APPLE_ID secrets rather than working out entitlements.

    Electron needs the JIT and unsigned-memory allowances for V8. The app reads
    and writes only files the user picks in a dialog, so user-selected
    read/write is the only file entitlement it asks for.
  -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
